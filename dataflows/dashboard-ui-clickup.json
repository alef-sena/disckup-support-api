        "func": "let discordIdToClickup = global.get('discordIdToClickup') || {};\n\nmsg.newRecord = true;\n\nif (discordIdToClickup[msg.payload.discordId]) {\n    msg.newRecord = false;\n}\n\ndiscordIdToClickup[msg.payload.discordId] = {\n    name: msg.payload.name,\n    clickupToken: msg.payload.clickupToken,\n    clickupId: msg.payload.clickupId,\n}\n\nmsg.discordIdToClickup = discordIdToClickup;\n\nglobal.set('discordIdToClickup', discordIdToClickup);\n\nreturn msg;",
