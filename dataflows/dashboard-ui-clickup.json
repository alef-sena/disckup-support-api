        "format": "<style>\n    :root {\n      --main-bg-color:#7b2cbe;\n    }\n\n    .row {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    \n    .card {\n      border-left: 3px solid var(--main-bg-color);;\n      border-radius: 5px;\n      box-shadow: 7px 7px 13px 0px rgba(50, 50, 50, 0.22);\n      padding: 30px;\n      margin: 20px;\n      width: 400px;\n      transition: all 0.3s ease-out;\n    }\n\n    .card p {\n      color: #a3a5ae;\n      font-size: 16px;\n      overflow: auto;\n    }\n    \n    md-sidenav {\n        background-color: #502773 !important;\n    }\n    .md-list-item-inner > ui-icon,  .md-list-item-inner > p {\n        /*color: white !important;*/\n    }\n    .nr-menu-item-active div button {\n        border-right: 2px solid white;\n    }\n    .body.nr-dashboard-theme md-sidenav div.md-list-item-inner {\n    /*color: white !important;*/\n    }\n    .cardPanel {\n        border: 1px solid black;\n        /*border-radius: 5px;*/\n        padding: 0px 10px 10px 10px;\n        \n    }\n    .cardPanel > .nr-dashboard-cardtitle  {\n        margin-left: 0px !important;\n        margin-bottom: 8px !important;\n        width: auto !important;\n        text-align: center;\n    }\n    .senseUpLogo {\n        /*width: 270px !important;*/\n        /*top: -40px !important;*/\n    }\n    /*button {*/\n        /*width: 100px !important;*/\n    /*    border-radius: 10px !important;*/\n        /*padding-left: 4px !important;*/\n    /*}*/\n\n    .removeButton  {\n        padding: 0px 5px 0px 13px !important;\n    }\n    .refreshButton {\n        padding: 0px 13px 0px 5px !important;\n    }\n    .tabulator {\n        /*width: 290px !important;*/\n        /*padding: -0 1px 0 14px !important;*/\n    }\n    .tabulator-header {\n        border-bottom: 1px solid #7b2cbe !important;\n        /*width: 289px !important;*/\n        color: white !important;\n        margin-left: 0px !important;\n    }\n    .tabulator-cell {\n        border-left: 1px solid #7b2cbe !important;\n        border-right: 1px solid #7b2cbe !important;\n        border-bottom: 1px solid #7b2cbe !important;\n    }\n    .tabulator-col {\n        border-left: 1px solid #7b2cbe !important;\n        border-right: 1px solid #7b2cbe !important;\n        border-top: 1px solid #7b2cbe !important;\n        background-color: #7b2cbe !important;\n        \n    }\n\n</style>\n",
