        "id": "10b0cb59447e081e",
        "type": "function",
        "z": "08a6082ba6a858b0",
        "g": "c6aad73a94e50c9a",
        "name": "Build Download Button Template",
        "func": "const url = `${global.get(\"clickUpSettings.general.flowBaseUrl\")}/clickup/mapping?mappingName=${msg.payload}`;\n\nmsg.template = `\n<!DOCTYPE html>\n<html>\n    <head>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <link rel=\"stylesheet\" href=\"https://www.w3schools.com/w3css/4/w3.css\">\n        <style>\n        .tooltip {\n          position: relative;\n          display: inline-block;\n        }\n        \n        .tooltypetext {\n            padding: 30px;\n            \n        }\n        \n        .tooltip .tooltiptext {\n          visibility: hidden;\n          width: 300px;\n          background-color: #555;\n          color: #fff;\n          text-align: center;\n          border-radius: 6px;\n          padding: 20px;\n          position: absolute;\n          z-index: 1;\n          bottom: 150%;\n          left: 50%;\n          margin-left: -75px;\n          opacity: 0;\n          transition: opacity 0.3s;\n          border: none\n        }\n        \n        .tooltip .tooltiptext::after {\n          content: \"\";\n          position: absolute;\n          top: 100%;\n          left: 50%;\n          margin-left: -5px;\n        }\n        \n        .tooltip:hover .tooltiptext {\n          visibility: visible;\n          opacity: 1;\n        }\n        \n        .btn {\n          background-color: #0094CE;\n          border: none;\n          color: white;\n          padding: 12px 16px;\n          font-size: 16px;\n          cursor: pointer;\n        }\n\n        .btn:hover {\n          background-color: #00AAED;\n        }\n        </style>\n    </head>\n<body>\n\n<h4>\n\n<div class=\"row\" style=\"margin-top:5px\">\n     <a href=\"${url}\" target=\"_blank\" />\n        <button class=\"btn\"><i class=\"fa fa-download\">\n        <span class=\"tooltiptext\" id=\"myTooltip\">Download the Mapping File</span>\n        </i></button>\n    </a>\n</div>\n\n</body>\n</html>\n\n`\nreturn msg;",
